# Settings of the "Ask" step. Copy this file to .env (at the project root, next to this file, or in a parent folder),
# fill it in and restart the app. Never commit the real .env.
#
# Any provider compatible with the OpenAI API works: set its key, its address and one of its models.
# Only the schema of the synthetic dataset (column names, types, categories) and your question are sent;
# no row, real or synthetic, ever leaves your computer.

# Groq (https://console.groq.com/keys): the tested configuration. The free plan has daily limits.
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# OpenAI (https://platform.openai.com/api-keys), not tested: use these lines instead (leave LLM_BASE_URL empty).
# gpt-6-luna reasons longer: if answers come back cut off, see "Language model" in the README.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_MODEL=gpt-6-luna
